{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.internal/schemas/ai_analysis_output.v1.json",
  "title": "AI analysis output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_output_id",
    "analysis_input_id",
    "snapshot_id",
    "evidence_digest",
    "purpose",
    "status",
    "summary",
    "claims",
    "limitations",
    "unavailable_reason"
  ],
  "properties": {
    "schema_version": {"const": "ai_analysis_output.v1"},
    "analysis_output_id": {"$ref": "#/$defs/uuid7"},
    "analysis_input_id": {"$ref": "#/$defs/uuid7"},
    "snapshot_id": {"$ref": "#/$defs/uuid7"},
    "evidence_digest": {"$ref": "#/$defs/sha256"},
    "purpose": {
      "enum": [
        "market_snapshot_explanation",
        "setup_explanation",
        "strategy_explanation",
        "risk_explanation",
        "availability_explanation"
      ]
    },
    "status": {"enum": ["available", "unavailable"]},
    "summary": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000},
    "claims": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "kind", "text", "citations"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^claim-[1-9][0-9]*$"},
          "kind": {"enum": ["explanation", "attention_guidance"]},
          "text": {"type": "string", "minLength": 1, "maxLength": 2000},
          "citations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/evidence_pointer"}
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "advisory_only",
          "single_snapshot_only",
          "delayed_evidence",
          "risk_unavailable",
          "decision_unavailable",
          "insufficient_evidence"
        ]
      }
    },
    "unavailable_reason": {
      "oneOf": [
        {"type": "null"},
        {
          "enum": [
            "provider_timeout",
            "provider_unavailable",
            "invalid_output",
            "missing_citation",
            "deterministic_state_contradiction",
            "prohibited_content",
            "cost_limit",
            "internal_unavailable"
          ]
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "available"}}},
      "then": {
        "properties": {
          "summary": {"type": "string"},
          "claims": {"minItems": 1},
          "limitations": {"contains": {"const": "advisory_only"}},
          "unavailable_reason": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "unavailable"}}},
      "then": {
        "properties": {
          "summary": {"type": "null"},
          "claims": {"maxItems": 0},
          "limitations": {"maxItems": 0},
          "unavailable_reason": {"type": "string"}
        }
      }
    }
  ],
  "$defs": {
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_pointer": {
      "type": "string",
      "pattern": "^/evidence/(?:[^~/*?#]|~0|~1)+(?:/(?:[^~/*?#]|~0|~1)+)*$"
    }
  }
}
