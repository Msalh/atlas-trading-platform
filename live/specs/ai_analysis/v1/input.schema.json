{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.internal/schemas/ai_analysis_input.v1.json",
  "title": "AI analysis input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_input_id",
    "created_at",
    "purpose",
    "snapshot",
    "evidence_items"
  ],
  "properties": {
    "schema_version": {"const": "ai_analysis_input.v1"},
    "analysis_input_id": {"$ref": "#/$defs/uuid7"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "purpose": {
      "enum": [
        "market_snapshot_explanation",
        "setup_explanation",
        "strategy_explanation",
        "risk_explanation",
        "availability_explanation"
      ]
    },
    "snapshot": {"$ref": "#/$defs/snapshot_reference"},
    "evidence_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "value"],
        "properties": {
          "path": {"$ref": "#/$defs/evidence_pointer"},
          "value": {}
        }
      }
    }
  },
  "$defs": {
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_pointer": {
      "type": "string",
      "pattern": "^/evidence/(?:[^~/*?#]|~0|~1)+(?:/(?:[^~/*?#]|~0|~1)+)*$"
    },
    "snapshot_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "evidence_digest",
        "snapshot_schema_version",
        "evidence_profile",
        "canonicalization_profile",
        "integrity_status"
      ],
      "properties": {
        "snapshot_id": {"$ref": "#/$defs/uuid7"},
        "evidence_digest": {"$ref": "#/$defs/sha256"},
        "snapshot_schema_version": {"const": "trader_now_snapshot.v1"},
        "evidence_profile": {"const": "trader_now_complete.v1"},
        "canonicalization_profile": {"const": "atlas-jcs.v1"},
        "integrity_status": {"const": "verified"}
      }
    }
  }
}
