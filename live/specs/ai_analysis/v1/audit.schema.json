{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.internal/schemas/ai_analysis_audit.v1.json",
  "title": "AI analysis audit record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_audit_id",
    "recorded_at",
    "analysis_input_id",
    "analysis_output_id",
    "snapshot_id",
    "evidence_digest",
    "purpose",
    "contract_versions",
    "outcome",
    "reason_code",
    "generator"
  ],
  "properties": {
    "schema_version": {"const": "ai_analysis_audit.v1"},
    "analysis_audit_id": {"$ref": "#/$defs/uuid7"},
    "recorded_at": {"$ref": "#/$defs/timestamp"},
    "analysis_input_id": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/uuid7"}]
    },
    "analysis_output_id": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/uuid7"}]
    },
    "snapshot_id": {"$ref": "#/$defs/uuid7"},
    "evidence_digest": {"$ref": "#/$defs/sha256"},
    "purpose": {
      "enum": [
        "market_snapshot_explanation",
        "setup_explanation",
        "strategy_explanation",
        "risk_explanation",
        "availability_explanation"
      ]
    },
    "contract_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "policy"],
      "properties": {
        "input": {"const": "ai_analysis_input.v1"},
        "output": {"const": "ai_analysis_output.v1"},
        "policy": {"const": "ai_analysis_policy.v1"}
      }
    },
    "outcome": {"enum": ["completed", "refused", "failed"]},
    "reason_code": {
      "oneOf": [
        {"type": "null"},
        {
          "enum": [
            "snapshot_stale",
            "snapshot_unavailable",
            "snapshot_integrity_failed",
            "snapshot_schema_unsupported",
            "provider_timeout",
            "provider_unavailable",
            "invalid_output",
            "missing_citation",
            "deterministic_state_contradiction",
            "prohibited_content",
            "cost_limit",
            "internal_unavailable"
          ]
        }
      ]
    },
    "generator": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider_id", "model_id"],
          "properties": {
            "provider_id": {"type": "string", "minLength": 1, "maxLength": 100},
            "model_id": {"type": "string", "minLength": 1, "maxLength": 200}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "completed"}}},
      "then": {
        "properties": {
          "analysis_input_id": {"type": "string"},
          "analysis_output_id": {"type": "string"},
          "reason_code": {"type": "null"},
          "generator": {"type": "object"}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "refused"}}},
      "then": {
        "properties": {
          "analysis_input_id": {"type": "null"},
          "analysis_output_id": {"type": "null"},
          "reason_code": {
            "enum": [
              "snapshot_stale",
              "snapshot_unavailable",
              "snapshot_integrity_failed",
              "snapshot_schema_unsupported"
            ]
          },
          "generator": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "failed"}}},
      "then": {
        "properties": {
          "analysis_input_id": {"type": "string"},
          "analysis_output_id": {"type": "null"},
          "reason_code": {"type": "string"}
        }
      }
    }
  ],
  "$defs": {
    "uuid7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
