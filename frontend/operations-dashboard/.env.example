# Dashboard operator boundary (server-only)
OPERATOR_USERNAME=
OPERATOR_PASSWORD=

# Private TraderNow service connection (server-only; never NEXT_PUBLIC_)
TRADER_NOW_INTERNAL_URL=
TRADER_NOW_API_KEY=

# Phase 17F Evidence Browser (server-only; disabled until release approval)
# Literal true only. Any other value fails closed.
EVIDENCE_BROWSER_ENABLED=false
# Absolute private http(s) origin only: no credentials, path, query, or fragment.
SNAPSHOT_API_INTERNAL_URL=
# Printable non-whitespace bearer token, 16-4096 characters. Never NEXT_PUBLIC_.
SNAPSHOT_READER_API_TOKEN=
